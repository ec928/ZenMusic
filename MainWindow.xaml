<Window
    x:Class="ZenMusic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:ui="using:ZenMusic.UI"
    xmlns:lib="using:ZenMusic.Library"
    xmlns:local="using:ZenMusic"
    Title="ZenMusic">

    <Grid x:Name="RootGrid" Background="Transparent" IsTabStop="True"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop"
          PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="30"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <Style x:Key="TransportIconBtnStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="17"/>
            </Style>
            <Style x:Key="ColumnHeaderBtnStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Margin" Value="-4,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="FolderMenuRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
            <Style x:Key="FolderMenuStarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="2,0,4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
            <Style x:Key="FolderMenuStarFilledIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter Property="Glyph" Value="&#xE735;"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource FavouriteStarBrush}"/>
            </Style>
            <Style x:Key="FolderMenuStarEmptyIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter Property="Glyph" Value="&#xE734;"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="FolderMenuHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="11,8,11,4"/>
            </Style>
            <Style x:Key="FolderMenuEmptyTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                <Setter Property="Margin" Value="11,8,11,8"/>
            </Style>
            <Style x:Key="FolderMenuDividerStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="-4,4,-4,4"/>
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            </Style>
            <MenuFlyout x:Key="VisualizerContextFlyout">
                <MenuFlyoutItem Text="Spectrum" Tag="Spectrum" Click="VisualizerContextMenuItem_Click"/>
                <MenuFlyoutItem Text="Silk Waveform" Tag="Waveform" Click="VisualizerContextMenuItem_Click"/>
                <MenuFlyoutItem Text="Bars + Wave" Tag="BarsAndWaveform" Click="VisualizerContextMenuItem_Click"/>
                <MenuFlyoutItem Text="Off" Tag="Off" Click="VisualizerContextMenuItem_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Open Focus Stage (F11)" Click="VisualizerContextFocusStage_Click"/>
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopBarRowDef" Height="44"/>
            <RowDefinition x:Name="WorkspaceRowDef" Height="*"/>
            <RowDefinition x:Name="PlaybarRowDef" Height="74"/>
        </Grid.RowDefinitions>

        <!-- Integrated Titlebar / Toolbar -->
        <Grid x:Name="MainTitleBar" Grid.Row="0" Background="{ThemeResource SidebarSurfaceBrush}" Padding="16,0,145,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource FavouriteStarBrush}"/>
                    <TextBlock Text="ZenMusic" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="OpenFolderBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Open music folder (Ctrl+O)" Click="OpenFolderBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE838;" FontSize="14"/>
                </Button>
                <Button x:Name="FoldersMenuBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Favourites and recent folders">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8F1;" FontSize="13.5"/>
                    <Button.Flyout>
                        <Flyout x:Name="RecentFoldersMenu" Placement="BottomEdgeAlignedLeft" Opening="RecentFoldersMenu_Opening">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="10"/>
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="MaxWidth" Value="900"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                        </Flyout>
                    </Button.Flyout>
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyout.MenuFlyoutPresenterStyle>
                                <Style TargetType="MenuFlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </MenuFlyout.MenuFlyoutPresenterStyle>
                            <MenuFlyoutItem Text="Clear recent folders" Click="ClearRecentFolders_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Delete"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>
                </Button>
                <Button x:Name="HygieneBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Browse albums, artists &amp; library filters">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="13.5"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Browse albums..." Click="BrowseAlbums_Click"/>
                            <MenuFlyoutItem Text="Browse artists..." Click="BrowseArtists_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Missing cover art" Tag="missing_art" Click="HygienePreset_Click"/>
                            <MenuFlyoutItem Text="Missing artist or album" Tag="missing_tags" Click="HygienePreset_Click"/>
                            <MenuFlyoutItem Text="Dirty filenames" Tag="dirty_names" Click="HygienePreset_Click"/>
                            <MenuFlyoutItem Text="Potential duplicates" Tag="duplicates" Click="HygienePreset_Click"/>
                            <MenuFlyoutItem Text="Low bitrate (&lt; 128 kbps)" Tag="low_bitrate" Click="HygienePreset_Click"/>
                            <MenuFlyoutItem Text="OneDrive cloud-only files" Tag="cloud_only" Click="HygienePreset_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ScopeClearBtn" Height="26" MinWidth="0" MinHeight="0" Padding="10,0" CornerRadius="13" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0,0,0" ToolTipService.ToolTip="Clear active filter" Click="ScopeClearBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="ScopeClearText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource FavouriteStarBrush}" VerticalAlignment="Center"/>
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="9"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Drag Region + Search -->
            <Grid Grid.Column="1" Margin="16,0">
                <Grid x:Name="TitleBarDragRegion" Background="Transparent"/>
                <Grid x:Name="SearchHostGrid" Width="320" MaxWidth="420" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBox x:Name="SearchBox" Height="30" CornerRadius="15" Padding="32,4,30,4" PlaceholderText="Search title, artist, album... (Ctrl+F)" FontSize="12" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"
                             BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                        <TextBox.Resources>
                            <!-- A pill has no flat bottom edge for the default underline to sit on: use an even 1px ring in every state. -->
                            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush"/>
                            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorSecondaryBrush"/>
                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="FavouriteStarBrush"/>
                        </TextBox.Resources>
                    </TextBox>
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <Button x:Name="ClearSearchBtn" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" ToolTipService.ToolTip="Clear search" Click="ClearSearchBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="ViewToggleBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Switch Track Table / Tile View" Click="ViewToggleBtn_Click">
                    <FontIcon x:Name="ViewToggleIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE80A;" FontSize="14"/>
                </Button>
                <Button x:Name="SettingsBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Settings (Audio, Visualizer, Theme, Rescan)" Click="SettingsBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="14"/>
                </Button>
                <Button x:Name="InfoBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Help &amp; About">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Keyboard shortcuts (F1)" Click="InfoShortcuts_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE765;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="About ZenMusic" Click="InfoAbout_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE946;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace (2-Pane: Center Library + Right Playlist/Queue Workbench) -->
        <Grid x:Name="MainWorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPaneCol" Width="316"/>
            </Grid.ColumnDefinitions>

            <!-- Center Canvas: Track Table / Album Grid -->
            <Grid x:Name="CenterWorkspaceGrid" Grid.Column="0" Background="{ThemeResource AppCanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TableHeaderRowDef" Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cover-art colour wash across the list: strongest by the playbar art, faint at the far corner -->
                <Border x:Name="CanvasTintLayer" Grid.RowSpan="2" IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3"/>
                    </Border.OpacityTransition>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0.85,0">
                            <GradientStop x:Name="CanvasTintStop" Color="#00000000" Offset="0.0"/>
                            <GradientStop x:Name="CanvasTintEndStop" Color="#00000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Table Column Header (Clickable for Sorting, Right-Click to Show/Hide Columns) -->
                <Grid x:Name="TableHeaderGrid" Grid.Row="0" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,0" RightTapped="TableHeaderGrid_RightTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderColTitle" Width="2.4*"/>
                        <ColumnDefinition x:Name="HeaderColArtist" Width="1.1*"/>
                        <ColumnDefinition x:Name="HeaderColAlbum" Width="1.2*"/>
                        <ColumnDefinition x:Name="HeaderColGenre" Width="0"/>
                        <ColumnDefinition x:Name="HeaderColYear" Width="48"/>
                        <ColumnDefinition x:Name="HeaderColRating" Width="78"/>
                        <ColumnDefinition x:Name="HeaderColLength" Width="56"/>
                        <ColumnDefinition x:Name="HeaderColDateAdded" Width="88"/>
                        <ColumnDefinition x:Name="HeaderColBitrate" Width="58"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TileSortLabel" Grid.Column="0" Text="Sort by" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Button x:Name="HeaderTitleBtn" Grid.Column="0" Tag="Title" Content="Title ▲" Style="{StaticResource ColumnHeaderBtnStyle}" Margin="28,0,-4,0" Click="SortHeader_Click"/>
                    <Button Grid.Column="1" Tag="Artist" Content="Artist" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="2" Tag="Album" Content="Album" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="3" Tag="Genre" Content="Genre" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="4" Tag="Year" Content="Year" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="5" Tag="Rating" Content="Rating" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="6" Tag="Duration" Content="Length" Style="{StaticResource ColumnHeaderBtnStyle}" HorizontalContentAlignment="Right" Margin="-4,0,4,0" Click="SortHeader_Click"/>
                    <Button Grid.Column="7" Tag="DateAdded" Content="Date Added" Style="{StaticResource ColumnHeaderBtnStyle}" HorizontalContentAlignment="Center" Margin="0" Click="SortHeader_Click"/>
                    <Button Grid.Column="8" Tag="Bitrate" Content="Bitrate" Style="{StaticResource ColumnHeaderBtnStyle}" HorizontalContentAlignment="Center" Margin="0" Click="SortHeader_Click"/>
                </Grid>

                <!-- Virtualized Track List -->
                <ListView x:Name="TracksListView" ShowsScrollingPlaceholders="False" Grid.Row="1" SelectionMode="Extended"
                          Padding="0,0,0,4"
                          CanDragItems="True" DragItemsStarting="TracksListView_DragItemsStarting"
                          IsDoubleTapEnabled="True" DoubleTapped="TracksListView_DoubleTapped"
                          SelectionChanged="TracksListView_SelectionChanged"
                          RightTapped="TracksListView_RightTapped"
                          ContainerContentChanging="AlbumsGridView_ContainerContentChanging">
                    <!-- A multi-select list shows no selection pill, and the stock selected fill equals the hover fill.
                         Selected is made clearly stronger than hover here. High contrast keeps the system colours. -->
                    <ListView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0FFFFFFF"/>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2AFFFFFF"/>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#34FFFFFF"/>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#24FFFFFF"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0A000000"/>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1E000000"/>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#26000000"/>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#1A000000"/>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="MinHeight" Value="30"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lib:TrackItem">
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="{x:Bind local:MainWindow.ColGenreWidth()}"/>
                                    <ColumnDefinition Width="{x:Bind local:MainWindow.ColYearWidth()}"/>
                                    <ColumnDefinition Width="{x:Bind local:MainWindow.ColRatingWidth()}"/>
                                    <ColumnDefinition Width="{x:Bind local:MainWindow.ColLengthWidth()}"/>
                                    <ColumnDefinition Width="{x:Bind local:MainWindow.ColDateAddedWidth()}"/>
                                    <ColumnDefinition Width="{x:Bind local:MainWindow.ColBitrateWidth()}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="9" Margin="-16,0" Background="{x:Bind local:MainWindow.PlayingRowTint}" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}" IsHitTestVisible="False"/>

                                <Border Grid.Column="0" Width="3" HorizontalAlignment="Left" Margin="-10,4,0,4" CornerRadius="2" Background="{ThemeResource FavouriteStarBrush}" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}"/>

                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center" Background="{x:Bind local:MainWindow.PlaceholderBrush(Artist, Album, DisplayTitle), Mode=OneWay}">
                                        <Grid>
                                            <TextBlock Text="{x:Bind ArtInitial, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{x:Bind local:MainWindow.ToImageSource(CoverThumbnail), Mode=OneWay}" Visibility="{x:Bind local:MainWindow.NotNullVis(CoverThumbnail), Mode=OneWay}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE753;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{x:Bind local:MainWindow.BoolVis(IsCloudOnly), Mode=OneWay}" ToolTipService.ToolTip="OneDrive cloud-only file (online)"/>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{x:Bind Artist, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Album, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind Genre, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind YearText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                <ui:StarRatingCell Grid.Column="5" Value="{x:Bind Rating, Mode=OneWay}" Quiet="{x:Bind local:MainWindow.Not(IsNowPlaying), Mode=OneWay}" RatingSelected="RowRatingCell_RatingSelected" Visibility="{x:Bind local:MainWindow.ColRatingVis()}" ToolTipService.ToolTip="Click stars (left half = .5, right half = .0; click again to clear)"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind DurationText, Mode=OneWay}" FontSize="12" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="7" Text="{x:Bind DateAddedText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DateAddedFullText, Mode=OneWay}" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="{x:Bind BitrateNumberText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind BitrateText, Mode=OneWay}" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Tile View (Shared Sort Order & Selection with Track Table) -->
                <GridView x:Name="AlbumsGridView" ShowsScrollingPlaceholders="False" Grid.Row="1" Visibility="Collapsed" SizeChanged="AlbumsGridView_SizeChanged"
                          Padding="14,12,14,12"
                          SelectionMode="Extended"
                          CanDragItems="True" DragItemsStarting="TracksListView_DragItemsStarting"
                          IsDoubleTapEnabled="True" DoubleTapped="TracksListView_DoubleTapped"
                          SelectionChanged="AlbumsGridView_SelectionChanged"
                          RightTapped="AlbumsGridView_RightTapped"
                          ContainerContentChanging="AlbumsGridView_ContainerContentChanging">
                    <!-- Same rule as the table: selected is clearly stronger than hover. -->
                    <GridView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#0FFFFFFF"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#2AFFFFFF"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#34FFFFFF"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#24FFFFFF"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#0A000000"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#1E000000"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#26000000"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#1A000000"/>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </GridView.Resources>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="lib:TrackItem">
                            <Grid Width="172" Height="246" Background="Transparent" PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited" PointerCanceled="Tile_PointerExited" PointerCaptureLost="Tile_PointerExited">
                                <Grid.TranslationTransition>
                                    <Vector3Transition Duration="0:0:0.14"/>
                                </Grid.TranslationTransition>
                                <Border CornerRadius="8" Background="{x:Bind local:MainWindow.PlayingRowTint}" BorderBrush="{ThemeResource FavouriteStarBrush}" BorderThickness="1.5" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}" IsHitTestVisible="False"/>
                                <StackPanel Spacing="5" Padding="10">
                                    <Grid x:Name="TileArt" Width="150" Height="150">
                                        <Border CornerRadius="6" Background="{x:Bind local:MainWindow.PlaceholderBrush(Artist, Album, DisplayTitle), Mode=OneWay}" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="{x:Bind ArtInitial, Mode=OneWay}" FontSize="64" FontWeight="SemiBold" Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{x:Bind local:MainWindow.ToImageSource(CoverThumbnail), Mode=OneWay}" Visibility="{x:Bind local:MainWindow.NotNullVis(CoverThumbnail), Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" CornerRadius="4" Padding="6,2" Background="#D9181818" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}">
                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="11" Foreground="{ThemeResource FavouriteStarBrush}"/>
                                        </Border>
                                        <Button x:Name="TilePlayBtn" Width="36" Height="36" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="18"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                                                Background="#E6181818" BorderBrush="#40FFFFFF" BorderThickness="1" Opacity="0"
                                                Tag="{x:Bind}" Click="TilePlayBtn_Click" ToolTipService.ToolTip="Play track">
                                            <Button.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.12"/>
                                            </Button.OpacityTransition>
                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="12" Foreground="#FFFFFF"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind DisplayArtist, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind TileMetaText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <ui:StarRatingCell Grid.Column="1" Value="{x:Bind Rating, Mode=OneWay}" Quiet="{x:Bind local:MainWindow.Not(IsNowPlaying), Mode=OneWay}" RatingSelected="RowRatingCell_RatingSelected" VerticalAlignment="Center" Margin="6,0,-2,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Type-to-Jump HUD Pill -->
                <Border x:Name="TypeJumpPill" Grid.Row="1" RequestedTheme="Dark"
                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,18,0"
                        Background="#E61E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1"
                        CornerRadius="8" Padding="12,6" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="TypeJumpText" Text="Jump: B" FontSize="12" FontWeight="SemiBold" Foreground="#FFC83B"/>
                </Border>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Visible" MaxWidth="420">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="EmptyStateTitle" Text="Choose your music folder to begin" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateSubtitle" Text="Supports MP3, FLAC, M4A, WAV, WMA, OGG with OneDrive cloud-safe scanning." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="EmptyStateActionBtn" Content="Open music folder" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="EmptyStateActionBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Right Sidebar: Unified Playlist / Queue Workbench + Resizable Splitter + Selected Track Inspector -->
            <Grid x:Name="RightSidebar" Grid.Column="1" Background="{ThemeResource SidebarSurfaceBrush}" Padding="12,10,12,10">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.18"/>
                </Grid.OpacityTransition>
                <Grid.TranslationTransition>
                    <Vector3Transition Duration="0:0:0.22"/>
                </Grid.TranslationTransition>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cover-art colour wash rising from the inspector -->
                <Border x:Name="PaneTintLayer" Grid.RowSpan="3" Margin="-12,-10,-12,-10" IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3"/>
                    </Border.OpacityTransition>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0.25">
                            <GradientStop x:Name="PaneTintStop" Color="#00000000" Offset="0.0"/>
                            <GradientStop x:Name="PaneTintEndStop" Color="#00000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Top: Unified Playlist & Play Queue Workbench -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="RightListModeCombo" Grid.Column="0" HorizontalAlignment="Stretch" Height="30" FontSize="12" Padding="10,4,6,4" SelectionChanged="RightListModeCombo_SelectionChanged" ToolTipService.ToolTip="Switch between Play Queue and Saved Playlists"/>
                        <Button x:Name="RightListPlayBtn" Grid.Column="1" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Play this list" Click="RightListPlayBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="11"/>
                        </Button>
                        <Button x:Name="QuickMixBtn" Grid.Column="2" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Instant Smart Mixes &amp; custom rules" Click="QuickMixBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE945;" FontSize="12"/>
                        </Button>
                        <Button x:Name="RightListMenuBtn" Grid.Column="3" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Playlist &amp; Queue actions" Click="RightListMenuBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE712;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <ListView x:Name="QueueListView" ShowsScrollingPlaceholders="False" Grid.Row="1" SelectionMode="Extended"
                              CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                              DragOver="QueueListView_DragOver" Drop="QueueListView_Drop" DragItemsCompleted="QueueListView_DragItemsCompleted"
                              SelectionChanged="QueueListView_SelectionChanged"
                              IsDoubleTapEnabled="True" DoubleTapped="QueueListView_DoubleTapped" RightTapped="QueueListView_RightTapped" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ContainerContentChanging="AlbumsGridView_ContainerContentChanging">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="lib:TrackItem">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center" Background="{x:Bind local:MainWindow.PlaceholderBrush(Artist, Album, DisplayTitle), Mode=OneWay}">
                                        <Grid>
                                            <TextBlock Text="{x:Bind ArtInitial, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{x:Bind local:MainWindow.ToImageSource(CoverThumbnail), Mode=OneWay}" Visibility="{x:Bind local:MainWindow.NotNullVis(CoverThumbnail), Mode=OneWay}" Stretch="UniformToFill"/>
                                            <Border Background="#99000000" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}">
                                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="14" Foreground="#FFC83B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="RightListEmptyHint" Grid.Row="1"
                               Text="Play queue is empty.&#x0a;Double-click any song to play&#x0a;or drag tracks here."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Margin="12" IsHitTestVisible="False" Visibility="Visible"/>
                </Grid>

                <!-- Draggable Splitter between Queue and Inspector -->
                <ui:ResizeGripBorder x:Name="RightPaneSplitter" Grid.Row="1" Height="10" Background="Transparent" ToolTipService.ToolTip="Drag up or down to resize Preview card" PointerPressed="RightPaneSplitter_PointerPressed" PointerMoved="RightPaneSplitter_PointerMoved" PointerReleased="RightPaneSplitter_PointerReleased">
                    <Border Width="36" Height="3" CornerRadius="1.5" Background="{ThemeResource SplitterHandleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ui:ResizeGripBorder>

                <!-- Bottom: Selected Track Inspector (3-State Art Click + Scrollable Plain / Synced Lyrics) -->
                <Border Grid.Row="2">
                    <ScrollViewer x:Name="SelectedInspectorScroll" MaxHeight="208" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="8">
                            <Grid x:Name="SelectedHeroGrid" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SelectedArtCol" Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Large Album Art with Bespoke Vinyl Disc Placeholder -->
                                <Border x:Name="SelectedArtBorder" Grid.Column="0" Width="112" Height="112" HorizontalAlignment="Left" CornerRadius="8" Background="{ThemeResource InspectorArtBgBrush}" BorderBrush="{ThemeResource PlaybarArtBorderBrush}" BorderThickness="1" Tapped="SelectedArtBorder_Tapped" ToolTipService.ToolTip="Click to cycle view: Compact / Full Art / Full Art + Overlay">
                                    <Grid>
                                        <Border x:Name="SelectedEmptyBg" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
                                        <Grid x:Name="SelectedDiscPlaceholder">
                                            <Ellipse Width="74" Height="74" Stroke="{ThemeResource ControlStrongStrokeColorDisabledBrush}" StrokeThickness="1.5" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse Width="24" Height="24" Stroke="#38FFC83B" StrokeThickness="1.5" Fill="#22000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE93C;" FontSize="14" Foreground="#90FFC83B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border x:Name="SelectedArtFallback" Visibility="Collapsed">
                                            <TextBlock x:Name="SelectedArtInitial" FontSize="72" FontWeight="SemiBold" Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image x:Name="SelectedArtImage" Stretch="UniformToFill">
                                            <Image.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.2"/>
                                            </Image.OpacityTransition>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Info & Rating Block -->
                                <Border x:Name="SelectedInfoOverlay" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Tapped="SelectedInfoOverlay_Tapped">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SelectedTitleText" Grid.Column="0" Text="No track selected" FontSize="13" LineHeight="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button x:Name="SelectedPropertiesBtn" Grid.Column="1" Width="24" Height="24" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="4" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Song Properties &amp; Lyrics (F2)" Click="SelectedPropertiesBtn_Click" IsEnabled="False">
                                                <FontIcon x:Name="SelectedPropertiesIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE70F;" FontSize="11"/>
                                            </Button>
                                        </Grid>

                                        <!-- Interactive Half-Star Rating Strip -->
                                        <StackPanel Orientation="Horizontal" Spacing="0" Margin="-2,0,0,0">
                                            <Button x:Name="StarBtn1" Tag="1" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 0.5★, right half for 1.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg1" Text="★" FontSize="13" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill1" Text="★" FontSize="13" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn2" Tag="2" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 1.5★, right half for 2.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg2" Text="★" FontSize="13" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill2" Text="★" FontSize="13" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn3" Tag="3" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 2.5★, right half for 3.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg3" Text="★" FontSize="13" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill3" Text="★" FontSize="13" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn4" Tag="4" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 3.5★, right half for 4.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg4" Text="★" FontSize="13" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill4" Text="★" FontSize="13" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn5" Tag="5" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 4.5★, right half for 5.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg5" Text="★" FontSize="13" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill5" Text="★" FontSize="13" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button Tag="0" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Clear rating">
                                                <FontIcon x:Name="SelectedClearRatingIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock x:Name="SelectedArtistText" Text="" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Tapped="SelectedArtistText_Tapped" ToolTipService.ToolTip="Click to filter library by this artist"/>
                                        <TextBlock x:Name="SelectedSpecsText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Lyrics teaser directly below hero card; supports plain or time-synced .LRC lines -->
                            <Border x:Name="SelectedLyricsContainer" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,2" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock x:Name="SelectedLyricsText" Text="" FontSize="12" LineHeight="17" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ListView x:Name="SelectedSyncedLyricsList" MaxHeight="200" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="LyricsLine_ItemClick" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="22"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="ui:LrcDisplayLine">
                                                <TextBlock Text="{x:Bind Text}" FontSize="12" FontWeight="{x:Bind LineWeight, Mode=OneWay}" Foreground="{x:Bind LineBrush, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Full-Canvas Listening Room / Focus Visualizer Stage (F11 or click Playbar Visualizer) -->
            <Grid x:Name="FocusVisualizerOverlay" Grid.Column="0" Grid.ColumnSpan="2" RequestedTheme="Dark"
                  Background="#FF0A0A0A" Visibility="Collapsed" Canvas.ZIndex="50">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.22"/>
                </Grid.OpacityTransition>
                <!-- Backdrop: the cover decoded tiny and stretched, which reads as a soft blur, under a dark veil -->
                <Image x:Name="FocusBackdropImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False">
                    <Image.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.8"/>
                    </Image.OpacityTransition>
                </Image>
                <Image x:Name="FocusBackdropImageB" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False">
                    <Image.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.8"/>
                    </Image.OpacityTransition>
                </Image>
                <Border Background="#66080808" IsHitTestVisible="False"/>
                <Border x:Name="FocusAmbientGlow" IsHitTestVisible="False" Opacity="0.45">
                    <Border.Background>
                        <RadialGradientBrush Center="0.32,0.34" GradientOrigin="0.32,0.34" RadiusX="0.58" RadiusY="0.58">
                            <GradientStop x:Name="FocusAmbientStop" Color="#FF0078D4" Offset="0.0"/>
                            <GradientStop Color="#000A0A0A" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Padding="48,28,48,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="FocusVizModeBtn" Style="{StaticResource TitleButtonStyle}" Click="FocusVizModeBtn_Click" ToolTipService.ToolTip="Cycle visualizer mode (Spectrum / Waveform / Bars + Wave / Off)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE9D9;" FontSize="12"/>
                                <TextBlock x:Name="FocusVizModeText" Text="Spectrum" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseFocusBtn" Style="{StaticResource TitleButtonStyle}" Click="CloseFocusBtn_Click" ToolTipService.ToolTip="Close Focus Visualizer (Esc / F11)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12"/>
                                <TextBlock Text="Close (F11)" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="40" HorizontalAlignment="Center" Margin="0,12,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
                            <Border Width="300" Height="300" CornerRadius="14" Background="#1E1E1E" BorderBrush="#2AFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Ellipse Width="140" Height="140" Stroke="#28FFFFFF" StrokeThickness="1.5" Fill="#16FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="42" Height="42" Stroke="#38FFC83B" StrokeThickness="1.5" Fill="#22000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE93C;" FontSize="28" Foreground="#90FFC83B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="FocusArtFallback" Visibility="Collapsed">
                                        <TextBlock x:Name="FocusArtInitial" FontSize="128" FontWeight="SemiBold" Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image x:Name="FocusArtImage" Stretch="UniformToFill">
                                        <Image.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.6"/>
                                        </Image.OpacityTransition>
                                    </Image>
                                    <Image x:Name="FocusArtImageB" Stretch="UniformToFill" Opacity="0">
                                        <Image.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.6"/>
                                        </Image.OpacityTransition>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="8" MaxWidth="440">
                                <TextBlock x:Name="FocusTitleText" Text="Not playing" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="FocusArtistText" Text="" FontSize="16" Foreground="#FFC83B" TextTrimming="CharacterEllipsis" Tapped="NowPlayingArtistText_Tapped" ToolTipService.ToolTip="Click to filter library by this artist"/>
                                <ui:StarRatingCell x:Name="FocusRatingCell" ForceDarkPalette="True" RatingSelected="NowPlayingRatingCell_RatingSelected" ToolTipService.ToolTip="Rate currently playing track"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="FocusLyricsHost" Grid.Column="1" Width="420" MaxHeight="300" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,12" Visibility="Collapsed">
                            <Grid>
                                <ScrollViewer x:Name="FocusPlainLyricsScroll" VerticalScrollBarVisibility="Hidden">
                                    <TextBlock x:Name="FocusLyricsText" Text="" FontSize="13.5" LineHeight="22" TextAlignment="Center" TextWrapping="Wrap" Foreground="#D9FFFFFF"/>
                                </ScrollViewer>
                                <ListView x:Name="FocusSyncedLyricsList" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="LyricsLine_ItemClick" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="26"/>
                                            <Setter Property="Padding" Value="6,3"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="ui:LrcDisplayLine">
                                            <TextBlock Text="{x:Bind Text}" FontSize="14" FontWeight="{x:Bind LineWeight, Mode=OneWay}" Foreground="{x:Bind LineBrush, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <ui:VisualizerControl x:Name="FocusVisualizer" Grid.Row="2"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Full-Width Bottom-Docked Symmetric 3-Zone Transport Console + Option B2 Symmetric Wings -->
        <Border x:Name="PlaybarBorder" Grid.Row="2"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                Margin="0" Height="74" CornerRadius="0"
                Background="{ThemeResource PlaybarAcrylicBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0"
                Padding="16,2,16,3" PointerPressed="PlaybarBorder_PointerPressed">
            <Grid>
            <!-- Cover-art colour wash spreading from the now-playing art -->
            <Border x:Name="PlaybarTintLayer" Margin="-16,-2,-16,-3" IsHitTestVisible="False">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.3"/>
                </Border.OpacityTransition>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.7,0.5">
                        <GradientStop x:Name="PlaybarTintStop" Color="#00000000" Offset="0.0"/>
                        <GradientStop x:Name="PlaybarTintEndStop" Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="248"/>
                </Grid.ColumnDefinitions>

                <!-- Zone 1: Now Playing Track Identity (54x54 Art + 3-Line Stack) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Background="Transparent" Tapped="NowPlayingInfo_Tapped" PointerEntered="NowPlayingInfo_PointerEntered" PointerExited="NowPlayingInfo_PointerExited" ToolTipService.ToolTip="Click to locate playing song in list (Ctrl+L)">
                    <Border Width="54" Height="54" CornerRadius="8" Background="{ThemeResource PlaybarArtBgBrush}" BorderBrush="{ThemeResource PlaybarArtBorderBrush}" BorderThickness="1">
                        <Grid>
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE93C;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Border x:Name="NowPlayingArtFallback" Visibility="Collapsed">
                                <TextBlock x:Name="NowPlayingArtInitial" FontSize="24" FontWeight="SemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="NowPlayingArtImage" Stretch="UniformToFill">
                                <Image.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.6"/>
                                </Image.OpacityTransition>
                            </Image>
                            <Image x:Name="NowPlayingArtImageB" Stretch="UniformToFill" Opacity="0">
                                <Image.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.6"/>
                                </Image.OpacityTransition>
                            </Image>
                            <Border x:Name="NowPlayingLocateBadge" Width="17" Height="17" CornerRadius="8.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                    Background="#BF101010" BorderBrush="#48FFFFFF" BorderThickness="1" Opacity="0.82">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE81D;" FontSize="9" Foreground="#FFC83B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Width="182" Spacing="1">
                        <TextBlock x:Name="NowPlayingTitleText" Text="Not playing" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowPlayingArtistText" Text="Select a song to play" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Tapped="NowPlayingArtistText_Tapped" ToolTipService.ToolTip="Click to filter library by this artist"/>
                        <ui:StarRatingCell x:Name="NowPlayingRatingCell" Margin="-2,1,0,0" RatingSelected="NowPlayingRatingCell_RatingSelected" ToolTipService.ToolTip="Rate currently playing track"/>
                    </StackPanel>
                </StackPanel>

                <!-- Zone 2: Option B2 Symmetric Transport Wings + Unobstructed Seek Rail -->
                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <!-- Elapsed · wing · transport · wing · total, centred in the bar -->
                    <Grid Height="50" MaxWidth="700" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ElapsedTimeText" Grid.Column="1" Text="00:00" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TotalTimeText" Grid.Column="3" Text="00:00" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>

                        <Border x:Name="PlaybarVisualizerLeftHost" Grid.Column="0" Height="46" Margin="0,0,14,1" Background="Transparent" VerticalAlignment="Bottom"
                                ContextFlyout="{StaticResource VisualizerContextFlyout}"
                                ToolTipService.ToolTip="Click to open Focus Visualizer Stage (F11) · Right-click to change mode or turn off" Tapped="PlaybarVisualizerHost_Tapped">
                            <ui:VisualizerControl x:Name="PlaybarVisualizerLeft" MirrorHorizontally="True"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="ShuffleToggle" Width="30" Height="30" Padding="0" CornerRadius="15" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Shuffle off" Click="ShuffleToggle_Click">
                                <Grid Width="30" Height="30">
                                    <FontIcon x:Name="ShuffleIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8B1;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="ShuffleActiveDot" Width="3.5" Height="3.5" Fill="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2.5" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="PrevBtn" AutomationProperties.Name="Previous" Width="30" Height="30" CornerRadius="15" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Previous" Click="PrevBtn_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="PlayPauseBtn" Width="36" Height="36" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="18" BorderThickness="0" ToolTipService.ToolTip="Play / Pause (Space)" Click="PlayPauseBtn_Click">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="ButtonBackground" Color="#1E1E1E"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#333333"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B45309"/>
                                                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF3D1"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE082"/>
                                                <SolidColorBrush x:Key="ButtonForeground" Color="#121212"/>
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#121212"/>
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#121212"/>
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="15"/>
                            </Button>
                            <Button x:Name="NextBtn" AutomationProperties.Name="Next" Width="30" Height="30" CornerRadius="15" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Next" Click="NextBtn_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="RepeatToggle" Width="30" Height="30" Padding="0" CornerRadius="15" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Repeat all (Click to cycle: Off / All / One)" Click="RepeatToggle_Click">
                                <Grid Width="30" Height="30">
                                    <FontIcon x:Name="RepeatIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8EE;" FontSize="13" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="RepeatActiveDot" Width="3.5" Height="3.5" Fill="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2.5"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border x:Name="PlaybarVisualizerRightHost" Grid.Column="4" Height="46" Margin="14,0,0,1" Background="Transparent" VerticalAlignment="Bottom"
                                ContextFlyout="{StaticResource VisualizerContextFlyout}"
                                ToolTipService.ToolTip="Click to open Focus Visualizer Stage (F11) · Right-click to change mode or turn off" Tapped="PlaybarVisualizerHost_Tapped">
                            <ui:VisualizerControl x:Name="PlaybarVisualizer"/>
                        </Border>
                    </Grid>

                </Grid>

                <!-- Zone 3: Balanced Right Audio Output & Stage Utilities -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SpeakerBadgeBtn" Padding="6,2" MinWidth="0" MinHeight="0" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" Click="SpeakerBadgeBtn_Click" ToolTipService.ToolTip="Click to switch output device or 2.0 / 5.1 layout">
                        <TextBlock x:Name="SpeakerBadgeText" Text="2.0 ch" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="MuteBtn" Width="28" Height="28" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Mute / Unmute" Click="MuteBtn_Click">
                        <FontIcon x:Name="VolumeIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Grid Width="72" Height="22" VerticalAlignment="Center">
                        <canvas:CanvasControl x:Name="VolumeRailCanvas" IsHitTestVisible="False" ClearColor="Transparent" Draw="VolumeRailCanvas_Draw"/>
                        <Slider x:Name="VolumeSlider" Width="72" Opacity="0" Minimum="0" Maximum="100" Value="70" MinHeight="20" Height="22" Padding="0" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" PointerEntered="VolumeSlider_PointerEntered" PointerExited="VolumeSlider_PointerExited"/>
                    </Grid>
                    <Button x:Name="RightPaneToggleBtn" Width="28" Height="28" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Hide Queue &amp; Track Panel (Ctrl+B)" Click="RightPaneToggleBtn_Click">
                        <FontIcon x:Name="RightPaneToggleIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE90D;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="MiniPlayerToggleBtn" Width="28" Height="28" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Collapse to Mini Player (Ctrl+M)" Click="MiniPlayerToggleBtn_Click">
                        <FontIcon x:Name="MiniPlayerIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE73F;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Full-width seek rail straddling the playbar's top edge (replaces the divider line) -->
            <Grid x:Name="SeekRailHost" Height="16" VerticalAlignment="Top" Margin="-16,-10,-16,0">
                <canvas:CanvasControl x:Name="SeekRailCanvas" IsHitTestVisible="False" ClearColor="Transparent" Draw="SeekRailCanvas_Draw"/>
                <Slider x:Name="SeekSlider" Opacity="0" Minimum="0" Maximum="100" Value="0" MinHeight="16" Height="16" Padding="0" VerticalAlignment="Center"
                        ValueChanged="SeekSlider_ValueChanged" PointerMoved="SeekSlider_PointerMoved" KeyUp="SeekSlider_KeyUp"
                        PointerEntered="SeekSlider_PointerEntered" PointerExited="SeekSlider_PointerExited"/>
            </Grid>
            </Grid>
        </Border>

        <!-- Settings panel: slides in over the right of the window; changes apply as they are made -->
        <Grid x:Name="SettingsOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Canvas.ZIndex="60">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.16"/>
            </Grid.OpacityTransition>
            <Border Background="#73000000" Tapped="SettingsScrim_Tapped"/>
            <Border x:Name="SettingsPanel" Width="500" HorizontalAlignment="Right"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Border.TranslationTransition>
                    <Vector3Transition Duration="0:0:0.2"/>
                </Border.TranslationTransition>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="20,14,12,10">
                        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="SettingsCloseBtn" AutomationProperties.Name="Close settings" Style="{StaticResource TitleButtonStyle}" HorizontalAlignment="Right" ToolTipService.ToolTip="Close (Esc)" Click="SettingsCloseBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <ScrollViewer x:Name="SettingsPanelHost" Grid.Row="1" Padding="20,0,20,20" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
