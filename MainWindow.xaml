<Window
    x:Class="ZenMusic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ZenMusic.UI"
    xmlns:lib="using:ZenMusic.Library"
    xmlns:local="using:ZenMusic"
    Title="ZenMusic">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppCanvasBrush}" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="30"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
            <Style x:Key="TransportIconBtnStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="17"/>
            </Style>
            <Style x:Key="ColumnHeaderBtnStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Integrated Titlebar / Toolbar -->
        <Grid Grid.Row="0" Background="{ThemeResource SidebarSurfaceBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="10,0,145,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="LeftPaneToggleBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Toggle Library &amp; Playlists" Click="LeftPaneToggleBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="14"/>
                </Button>
                <Button x:Name="OpenFolderBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Open Music Folder" Click="OpenFolderBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE838;" FontSize="14"/>
                        <TextBlock Text="Open folder" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock x:Name="ScopePillText" Text="All music · 0 tracks" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Drag Region + Search -->
            <Grid Grid.Column="1" Margin="16,0">
                <Grid x:Name="TitleBarDragRegion" Background="Transparent"/>
                <TextBox x:Name="SearchBox" Width="320" MaxWidth="420" Height="30" PlaceholderText="Search title, artist, album... (Ctrl+F)" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="RescanBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Rescan folder" Click="RescanBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="14"/>
                </Button>
                <Button x:Name="RightPaneToggleBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Toggle Queue &amp; Inspector" Click="RightPaneToggleBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE90B;" FontSize="14"/>
                </Button>
                <Button x:Name="ThemeToggleBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Switch Light / Dark theme" Click="ThemeToggleBtn_Click">
                    <FontIcon x:Name="ThemeIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE708;" FontSize="14"/>
                </Button>
                <Button x:Name="SettingsBtn" Style="{StaticResource TitleButtonStyle}" ToolTipService.ToolTip="Settings (Audio 2.0 / 5.1, Visualizer, Library)" Click="SettingsBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace (3-Pane Hybrid + Floating Dark Playbar) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneCol" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPaneCol" Width="276"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Library & Playlists -->
            <Grid x:Name="LeftSidebar" Grid.Column="0" Visibility="Collapsed" Background="{ThemeResource SidebarSurfaceBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="10,12,10,88">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="PlayAllBtn" Grid.Row="0" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="12,7" Margin="0,0,0,12" Click="PlayAllBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="12"/>
                        <TextBlock Text="Play selection" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="4">
                        <Grid Margin="6,2,2,4">
                            <TextBlock Text="Library" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Padding="6,2" MinWidth="0" MinHeight="0" CornerRadius="4" ToolTipService.ToolTip="Add custom filter criteria (e.g. 3★+)" Click="NewFilterBtn_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="11"/>
                            </Button>
                        </Grid>
                        <ListView x:Name="FacetList" SelectionMode="Single" SelectedIndex="0" SelectionChanged="FacetList_SelectionChanged">
                            <ListViewItem x:Name="FacetAllItem" Tag="all" Content="All music"/>
                            <ListViewItem x:Name="FacetRecentItem" Tag="recent" Content="Recently added"/>
                            <ListViewItem x:Name="FacetTopRatedItem" Tag="toprated" Content="Top rated (4★+)"/>
                            <ListViewItem x:Name="FacetFiveStarItem" Tag="5star" Content="5★ Favorites"/>
                            <ListViewItem x:Name="FacetUnratedItem" Tag="unrated" Content="Unrated"/>
                        </ListView>

                        <ListView x:Name="CustomFiltersList" SelectionMode="Single" SelectionChanged="CustomFiltersList_SelectionChanged" RightTapped="CustomFiltersList_RightTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="lib:CustomFilterCriteria">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{ThemeResource FavouriteStarBrush}"/>
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Margin="6,14,2,4">
                            <TextBlock Text="Playlists" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Padding="6,2" MinWidth="0" MinHeight="0" CornerRadius="4" ToolTipService.ToolTip="New playlist" Click="NewPlaylistBtn_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="11"/>
                            </Button>
                        </Grid>
                        <ListView x:Name="PlaylistsList" SelectionMode="Single" SelectionChanged="PlaylistsList_SelectionChanged" RightTapped="PlaylistsList_RightTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="lib:SavedPlaylist">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE90B;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Center Canvas: Track Table + Status Footer -->
            <Grid Grid.Column="1" Padding="0,0,0,84">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <!-- Table Column Header (Clickable for Sorting, Pixel-Aligned with Row Padding) -->
                <Grid x:Name="TableHeaderGrid" Grid.Row="0" Background="{ThemeResource SidebarSurfaceBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="124"/>
                        <ColumnDefinition Width="68"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Tag="Index" Content="# ▲" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="1" Tag="Title" Content="Title" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="2" Tag="Artist" Content="Artist" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="3" Tag="Album" Content="Album" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="4" Tag="Year" Content="Year" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="5" Tag="Rating" Content="Rating" Style="{StaticResource ColumnHeaderBtnStyle}" Click="SortHeader_Click"/>
                    <Button Grid.Column="6" Tag="Duration" Content="Length" Style="{StaticResource ColumnHeaderBtnStyle}" HorizontalContentAlignment="Right" Click="SortHeader_Click"/>
                    <Button Grid.Column="7" Tag="DateAdded" Content="Date Added" Style="{StaticResource ColumnHeaderBtnStyle}" Margin="6,0,0,0" Click="SortHeader_Click"/>
                    <Button Grid.Column="8" Tag="Bitrate" Content="Bitrate" Style="{StaticResource ColumnHeaderBtnStyle}" HorizontalContentAlignment="Right" Click="SortHeader_Click"/>
                </Grid>

                <!-- Virtualized Track List -->
                <ListView x:Name="TracksListView" Grid.Row="1" SelectionMode="Extended"
                          IsDoubleTapEnabled="True" DoubleTapped="TracksListView_DoubleTapped"
                          SelectionChanged="TracksListView_SelectionChanged"
                          RightTapped="TracksListView_RightTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="MinHeight" Value="30"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lib:TrackItem">
                            <Grid Height="30" Background="{x:Bind local:MainWindow.RowBackground(IsNowPlaying, Index), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="124"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" HorizontalAlignment="Left" Margin="-8,4,0,4" CornerRadius="2" Background="#FFC83B" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}"/>
                                <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="13" Foreground="#FFC83B" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}"/>
                                <TextBlock Grid.Column="0" Text="{x:Bind Index}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:MainWindow.NotNowPlayingVis(IsNowPlaying), Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind Album}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind YearText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <ui:StarRatingCell Grid.Column="5" Value="{x:Bind Rating, Mode=OneWay}" RatingSelected="RowRatingCell_RatingSelected" ToolTipService.ToolTip="Click stars (left half = .5, right half = .0; click again to clear)"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind DurationText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="7" Text="{x:Bind DateAddedText, Mode=OneWay}" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="8" Text="{x:Bind BitrateText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Type-to-Jump HUD Pill -->
                <Border x:Name="TypeJumpPill" Grid.Row="1" RequestedTheme="Dark"
                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,18,0"
                        Background="#E61E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1"
                        CornerRadius="8" Padding="12,6" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="TypeJumpText" Text="Jump: B" FontSize="12" FontWeight="SemiBold" Foreground="#FFC83B"/>
                </Border>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Visible">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Choose your music folder to begin" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Supports MP3, FLAC, M4A, WAV, WMA, OGG with OneDrive cloud-safe scanning." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Button Content="Open music folder" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OpenFolderBtn_Click"/>
                </StackPanel>

                <!-- MediaMonkey-Style Library Status Footer -->
                <Border Grid.Row="2" Background="{ThemeResource SidebarSurfaceBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                    <TextBlock x:Name="StatusFooterText" Text="0 tracks" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <!-- Right Sidebar: Now Playing Queue + Resizable Splitter + Selected Track Inspector -->
            <Grid x:Name="RightSidebar" Grid.Column="2" Background="{ThemeResource SidebarSurfaceBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="12,10,12,88">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: Now Playing Queue -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="QueueHeaderText" Text="Now playing (0)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,28,0"/>
                        <Button HorizontalAlignment="Right" Padding="6,2" MinWidth="0" MinHeight="0" CornerRadius="4" ToolTipService.ToolTip="Save queue as playlist" Click="SaveQueueAsPlaylistBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <ListView x:Name="QueueListView" Grid.Row="1" IsDoubleTapEnabled="True" DoubleTapped="QueueListView_DoubleTapped" RightTapped="QueueListView_RightTapped" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="lib:TrackItem">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="11" Foreground="#FFC83B" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{x:Bind local:MainWindow.NowPlayingVis(IsNowPlaying), Mode=OneWay}"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Text="{x:Bind DisplayTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Draggable Splitter between Queue and Inspector -->
                <Border x:Name="RightPaneSplitter" Grid.Row="1" Height="10" Background="Transparent" ToolTipService.ToolTip="Drag up or down to resize Preview card" PointerPressed="RightPaneSplitter_PointerPressed" PointerMoved="RightPaneSplitter_PointerMoved" PointerReleased="RightPaneSplitter_PointerReleased">
                    <Border Width="36" Height="3" CornerRadius="1.5" Background="#30FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Bottom: Selected Track Inspector (3-State Art Click + Scrollable Lyrics without Scrollbar) -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <ScrollViewer x:Name="SelectedInspectorScroll" MaxHeight="208" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="8">
                            <Grid x:Name="SelectedHeroGrid" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SelectedArtCol" Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Large Album Art with Bespoke Vinyl Disc Placeholder (Click to cycle: Compact -> Max Art -> Max Art + Overlay) -->
                                <Border x:Name="SelectedArtBorder" Grid.Column="0" Width="112" Height="112" HorizontalAlignment="Left" CornerRadius="8" Background="#1E1E1E" BorderBrush="#22FFFFFF" BorderThickness="1" Tapped="SelectedArtBorder_Tapped" ToolTipService.ToolTip="Click to cycle view: Compact / Full Art / Full Art + Overlay">
                                    <Grid>
                                        <Ellipse Width="74" Height="74" Stroke="#28FFFFFF" StrokeThickness="1.5" Fill="#16FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="24" Height="24" Stroke="#38FFC83B" StrokeThickness="1.5" Fill="#22000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE93C;" FontSize="14" Foreground="#90FFC83B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="SelectedArtImage" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <!-- Info & Rating Block (Right column in Mode 0, Hidden in Mode 1, Superimposed bottom bar in Mode 2) -->
                                <Border x:Name="SelectedInfoOverlay" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Tapped="SelectedInfoOverlay_Tapped">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SelectedTitleText" Grid.Column="0" Text="No track selected" FontSize="12.5" LineHeight="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button x:Name="SelectedPropertiesBtn" Grid.Column="1" Width="24" Height="24" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="4" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Song Properties &amp; Lyrics" Click="SelectedPropertiesBtn_Click" IsEnabled="False">
                                                <FontIcon x:Name="SelectedPropertiesIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE70F;" FontSize="11"/>
                                            </Button>
                                        </Grid>

                                        <!-- Interactive Half-Star Rating Strip -->
                                        <StackPanel Orientation="Horizontal" Spacing="0" Margin="-2,0,0,0">
                                            <Button x:Name="StarBtn1" Tag="1" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 0.5★, right half for 1.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg1" Text="★" FontSize="12.5" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill1" Text="★" FontSize="12.5" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn2" Tag="2" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 1.5★, right half for 2.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg2" Text="★" FontSize="12.5" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill2" Text="★" FontSize="12.5" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn3" Tag="3" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 2.5★, right half for 3.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg3" Text="★" FontSize="12.5" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill3" Text="★" FontSize="12.5" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn4" Tag="4" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 3.5★, right half for 4.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg4" Text="★" FontSize="12.5" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill4" Text="★" FontSize="12.5" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="StarBtn5" Tag="5" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Click left half for 4.5★, right half for 5.0★ (click again to clear)">
                                                <Grid Width="14" Height="16">
                                                    <TextBlock x:Name="StarBg5" Text="★" FontSize="12.5" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarFill5" Text="★" FontSize="12.5" Foreground="{ThemeResource FavouriteStarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button Tag="0" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="RateStarBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Clear rating">
                                                <FontIcon x:Name="SelectedClearRatingIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock x:Name="SelectedArtistText" Text="" FontSize="11.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SelectedSpecsText" Text="" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Lyrics teaser directly below hero card; scroll down to read in full pane -->
                            <Border x:Name="SelectedLyricsContainer" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,2" Visibility="Collapsed">
                                <TextBlock x:Name="SelectedLyricsText" Text="" FontSize="11.5" LineHeight="17" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Pinned-Dark Floating Transport Bar + Optional Embedded Visualizer -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" RequestedTheme="Dark"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Margin="16,0,16,12" Height="66" CornerRadius="12"
                    Background="#E6181818" BorderBrush="#26FFFFFF" BorderThickness="1"
                    Padding="14,6">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="268"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Playing Track Info (Click to locate in list; inline stars to rate playing song anytime) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Background="Transparent" Tapped="NowPlayingInfo_Tapped" ToolTipService.ToolTip="Click to locate playing song in list">
                        <Border Width="46" Height="46" CornerRadius="6" Background="#2A2A2A">
                            <Grid>
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE93C;" FontSize="18" Foreground="#80FFFFFF"/>
                                <Image x:Name="NowPlayingArtImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Width="206" Spacing="1">
                            <TextBlock x:Name="NowPlayingTitleText" Text="Not playing" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="NowPlayingArtistText" Text="Select a song to play" FontSize="11" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="92" VerticalAlignment="Center"/>
                                <Border Background="#22FFFFFF" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpeakerBadgeText" Text="2.0" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFC83B"/>
                                </Border>
                                <ui:StarRatingCell x:Name="NowPlayingRatingCell" RatingSelected="NowPlayingRatingCell_RatingSelected" ToolTipService.ToolTip="Rate currently playing track"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Transport Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton x:Name="ShuffleToggle" Width="30" Height="30" Padding="0" CornerRadius="15" ToolTipService.ToolTip="Shuffle" Click="ShuffleToggle_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8B1;" FontSize="13"/>
                        </ToggleButton>
                        <Button Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Previous" Click="PrevBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="14"/>
                        </Button>
                        <Button x:Name="PlayPauseBtn" Width="38" Height="38" Padding="0" CornerRadius="19" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause (Space)" Click="PlayPauseBtn_Click">
                            <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Next" Click="NextBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="14"/>
                        </Button>
                        <ToggleButton x:Name="RepeatToggle" Width="30" Height="30" Padding="0" CornerRadius="15" IsChecked="True" ToolTipService.ToolTip="Repeat all" Click="RepeatToggle_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8EE;" FontSize="13"/>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Scrubber -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedTimeText" Grid.Column="0" Text="00:00" FontSize="11" Foreground="#B3FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" ValueChanged="SeekSlider_ValueChanged" PointerMoved="SeekSlider_PointerMoved" KeyUp="SeekSlider_KeyUp"/>
                        <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00" FontSize="11" Foreground="#B3FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Optional Embedded 60fps Win2D Visualizer (Click to expand F11 stage) -->
                    <Border x:Name="PlaybarVisualizerHost" Grid.Column="3" Height="44" CornerRadius="6" Background="#14FFFFFF" Padding="6,4" ToolTipService.ToolTip="Click to expand Focus Visualizer (F11)" Tapped="PlaybarVisualizerHost_Tapped">
                        <ui:VisualizerControl x:Name="PlaybarVisualizer"/>
                    </Border>

                    <!-- Visualizer Toggle & Volume -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="VisualizerToggleBtn" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Toggle Visualizer On / Off" Click="VisualizerToggleBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE9D9;" FontSize="14"/>
                        </Button>
                        <Button x:Name="MuteBtn" Style="{StaticResource TransportIconBtnStyle}" ToolTipService.ToolTip="Mute / Unmute" Click="MuteBtn_Click">
                            <FontIcon x:Name="VolumeIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="13" Foreground="#B3FFFFFF"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="82" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Full-Canvas Listening Room / Focus Visualizer Stage (F11 or click Playbar Visualizer) -->
            <Grid x:Name="FocusVisualizerOverlay" Grid.Column="0" Grid.ColumnSpan="3" RequestedTheme="Dark"
                  Background="#F50A0A0A" Visibility="Collapsed" Canvas.ZIndex="50" Padding="48,28,48,96">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource TitleButtonStyle}" Click="CloseFocusBtn_Click" ToolTipService.ToolTip="Close Focus Visualizer (Esc / F11)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12"/>
                        <TextBlock Text="Close (F11)" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" ColumnSpacing="36" HorizontalAlignment="Center" Margin="0,8,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <Border Width="180" Height="180" CornerRadius="12" Background="#1E1E1E" BorderBrush="#2AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Ellipse Width="120" Height="120" Stroke="#28FFFFFF" StrokeThickness="1.5" Fill="#16FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="38" Height="38" Stroke="#38FFC83B" StrokeThickness="1.5" Fill="#22000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE93C;" FontSize="24" Foreground="#90FFC83B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="FocusArtImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="8" MaxWidth="440">
                            <TextBlock x:Name="FocusTitleText" Text="Not playing" FontSize="26" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FocusArtistText" Text="" FontSize="15" Foreground="#FFC83B" TextTrimming="CharacterEllipsis"/>
                            <ui:StarRatingCell x:Name="FocusRatingCell" RatingSelected="NowPlayingRatingCell_RatingSelected" ToolTipService.ToolTip="Rate currently playing track"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="FocusLyricsHost" Grid.Column="1" Width="380" MaxHeight="180" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,12" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <TextBlock x:Name="FocusLyricsText" Text="" FontSize="13" LineHeight="20" TextAlignment="Center" TextWrapping="Wrap" Foreground="#D9FFFFFF"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <ui:VisualizerControl x:Name="FocusVisualizer" Grid.Row="2"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
