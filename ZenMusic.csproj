<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ZenMusic</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>0.7.21</Version>
    <AssemblyVersion>0.7.21.0</AssemblyVersion>
    <FileVersion>0.7.21.0</FileVersion>
    <Product>ZenMusic</Product>
    <ApplicationIcon>ZenMusic.ico</ApplicationIcon>

    <!-- Output straight to Bin\ without TFM or RID subfolders. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>Bin\</OutputPath>
    <PublishDir>Bin\</PublishDir>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishSingleFile>False</PublishSingleFile>
  </PropertyGroup>

  <Target Name="TrimLocaleResourceFolders" AfterTargets="Build;Publish">
    <ItemGroup>
      <_AllMui Include="$(OutDir)*\*.mui" />
      <_KeepMui Include="$(OutDir)en*\*.mui" />
      <_DropMui Include="@(_AllMui)" Exclude="@(_KeepMui)" />
    </ItemGroup>
    <Delete Files="@(_DropMui)" ContinueOnError="true" />
    <RemoveDir Directories="@(_DropMui->'%(RootDir)%(Directory)'->Distinct())" ContinueOnError="true" />
  </Target>

  <Target Name="RemoveUnusedWindowsML" AfterTargets="Build;Publish">
    <ItemGroup>
      <_UnusedMl Include="$(OutDir)onnxruntime.dll" />
      <_UnusedMl Include="$(OutDir)DirectML.dll" />
      <_UnusedMl Include="$(OutDir)Microsoft.ML.OnnxRuntime.dll" />
      <_UnusedMl Include="$(OutDir)NPUDetect.dll" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.AI.*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.Internal.AI.*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*Vision*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*SemanticSearch*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*ImageCreation*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*ContentModeration*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.Workloads*" />
      <_UnusedMl Include="$(OutDir)workloads.json" />
      <_UnusedMl Include="$(OutDir)workloads.*.json" />
      <_UnusedMl Include="$(OutDir)Microsoft.Graphics.*Imaging*" />
    </ItemGroup>
    <Delete Files="@(_UnusedMl)" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="ZenMusic.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ZenMusic.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <ApplicationDefinition Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>
</Project>
