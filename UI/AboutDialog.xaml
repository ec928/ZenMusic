<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ZenMusic.UI.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
        <Style x:Key="AboutGlyph" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{ThemeResource FavouriteStarBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="AboutItemTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="AboutItemBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="500" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IsTabStop=False keeps the dialog from focusing the scroll container on open. -->
        <ScrollViewer x:Name="BodyScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="560"
                      IsTabStop="False">
            <StackPanel Spacing="0">

                <!-- Header band. Its wash is the colour of the playing track (set from code), amber when idle. -->
                <Grid CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Border x:Name="HeroTint" CornerRadius="10"/>
                    <Grid Padding="20,18" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AppIconImage" Width="64" Height="64" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ZenMusic" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="A calm home for the music you own."
                                       FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <!-- Populated at runtime from assembly version metadata so it never drifts. -->
                            <TextBlock x:Name="VersionText" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <TextBlock x:Name="TintNote"
                           Visibility="Collapsed"
                           Text="This header is wearing the colour of the current track."
                           FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Margin="2,8,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <Grid Margin="2,14,12,0" ColumnSpacing="14" RowSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <FontIcon Grid.Row="0" Glyph="&#xE790;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="It takes on the colour of your music" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="The playing track's cover washes the window in its colour, and fades to the next as the track changes. A track with no cover gets one in its artist's own colour."/>
                    </StackPanel>

                    <FontIcon Grid.Row="1" Glyph="&#xE740;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="A stage for listening" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="F11 fills the window with the cover, a visualizer and the lyrics. Synced lyrics light up line by line."/>
                    </StackPanel>

                    <FontIcon Grid.Row="2" Glyph="&#xE7F5;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Sound for the speakers you have" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Stereo, 2.1 or 5.1: spread stereo across a surround system, or play multichannel files as they are."/>
                    </StackPanel>

                    <FontIcon Grid.Row="3" Glyph="&#xE8F1;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="Thousands of tracks, no waiting" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Opens from a cache and keeps up with the folder. Click a column to sort, type to search, rate in half stars saved into the files."/>
                    </StackPanel>

                    <FontIcon Grid.Row="4" Glyph="&#xE8EC;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="Tidy tags, covers and lyrics" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Auto-Tag looks up titles, artwork and lyrics online, and you choose what to keep. F2 edits one track or many; Ctrl+Z undoes it."/>
                    </StackPanel>

                    <FontIcon Grid.Row="5" Glyph="&#xE72E;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="5" Grid.Column="1">
                        <TextBlock Text="Private and portable" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="No account, no ads, no tracking. It runs from any folder and goes online only when you run Auto-Tag."/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Free and open source under the MIT licence."
                           FontSize="12" Margin="2,14,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Report a problem" HorizontalAlignment="Stretch" Click="ReportButton_Click"/>
            <Button Grid.Column="1" Content="View on GitHub" HorizontalAlignment="Stretch" Click="ProjectButton_Click"/>
            <Button Grid.Column="2" Content="Close" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
