<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ZenMusic.UI.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="About ZenMusic">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
        <Style x:Key="AboutSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="80"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="AboutBullet" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="500" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IsTabStop=False keeps the dialog from focusing a link/scroll container on open. -->
        <ScrollViewer x:Name="BodyScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="400"
                      IsTabStop="False">
            <StackPanel Spacing="0" Padding="0,0,12,0">

                <!-- Brand header -->
                <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap">
                    <Run Text="ZenMusic" Foreground="{ThemeResource FavouriteStarBrush}"/><Run Text=": WASAPI Music Player, Tag Editor &amp; Lyrics Stage"/>
                </TextBlock>

                <!-- Populated at runtime from assembly version metadata so it never drifts. -->
                <TextBlock x:Name="VersionText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>

                <TextBlock Text="A fast, native Windows music player built with WinUI 3, Win2D, and NAudio WASAPI. Browse and rate multi-thousand-track libraries effortlessly, route audio cleanly to 2.0, 2.1, or 5.1 speaker systems, edit tags and synced lyrics, and listen inside a distraction-free visualizer stage."
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Text="LIBRARY &amp; BROWSING" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Table &amp; Album Tile views" FontWeight="SemiBold"/><Run Text=" &#x2014; switch between a dense multi-column table with embedded row art and an album cover grid, with instant search (Ctrl+F), type-to-jump, and cached startup."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Half-star ratings &amp; filtering" FontWeight="SemiBold"/><Run Text=" &#x2014; click any track's stars (left half = .5, right half = .0) saved straight to audio file tags, and filter by star rating, search terms, or clicked artist names."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Play Queue &amp; saved playlists" FontWeight="SemiBold"/><Run Text=" &#x2014; drag tracks into your Play Queue or create, reorder, and play custom playlists from the right-hand workbench alongside the Inspector card."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Live folder watch &amp; file launch" FontWeight="SemiBold"/><Run Text=" &#x2014; tracks added, edited, or stored as OneDrive cloud-only placeholders update cleanly, and clicking an associated audio file launches straight into playback."/>
                </TextBlock>

                <TextBlock Text="AUDIO &amp; VISUALIZATION" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="WASAPI audio engine" FontWeight="SemiBold"/><Run Text=" &#x2014; clean native playback for MP3, FLAC, M4A, AAC, WAV, WMA, OGG, and Opus with selectable output devices and automatic recovery."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="2.0, 2.1 &amp; 5.1 speaker routing" FontWeight="SemiBold"/><Run Text=" &#x2014; choose 2.0 Stereo, 2.1 + LFE (&lt;80 Hz crossover), 5.1 Smart Upmix with adjustable center vocal fill and rear ambience, or 5.1 Direct multichannel passthrough."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Visualizers &amp; F11 Focus Stage" FontWeight="SemiBold"/><Run Text=" &#x2014; GPU-rendered Spectrum bars and Silk waveform modes in both the playbar and the full-screen Focus Stage with cover-art color tinting."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Compact Mini Player" FontWeight="SemiBold"/><Run Text=" &#x2014; collapse the window to an always-handy Mini Player bar anytime with Ctrl+M."/>
                </TextBlock>

                <TextBlock Text="TAGS, COVER ART &amp; LYRICS" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Auto-Tag &amp; Cover Lookup" FontWeight="SemiBold"/><Run Text=" &#x2014; fetch clean titles, release metadata, high-resolution artwork, and lyrics from MusicBrainz, iTunes, and LRCLIB with diff checkboxes and filename cleanup."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Properties, batch editing &amp; Undo" FontWeight="SemiBold"/><Run Text=" &#x2014; press F2 to edit single tracks or multiple songs together, swap cover art, inspect codec details, and undo changes with Ctrl+Z."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Synced .lrc &amp; embedded lyrics" FontWeight="SemiBold"/><Run Text=" &#x2014; automatic highlighting of timed .lrc sidecar or embedded lyrics with click-to-seek in both the Inspector and Focus Stage."/>
                </TextBlock>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,16,0,12"/>

                <TextBlock TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Free and open source under the MIT licence. Portable with no registry changes; settings and cache live in %LocalAppData%\ZenMusic (or a Data folder beside ZenMusic.exe). Online lookups run only when you invoke Auto-Tag."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Report a problem" HorizontalAlignment="Stretch" Click="ReportButton_Click"/>
            <Button Grid.Column="1" Content="View on GitHub" HorizontalAlignment="Stretch" Click="ProjectButton_Click"/>
            <Button Grid.Column="2" Content="Close" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
