<Application
    x:Class="ZenMusic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZenMusic">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FavouriteStarBrush" Color="#D97706"/>
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#99F3F3F3"/>
                    <SolidColorBrush x:Key="EvenRowBrush" Color="#09000000"/>
                    <SolidColorBrush x:Key="PlayingRowBrush" Color="#22D97706"/>
                    <SolidColorBrush x:Key="SplitterHandleBrush" Color="#40000000"/>
                    <SolidColorBrush x:Key="PlaybarAcrylicBrush" Color="#A6EFEFEF"/>
                    <SolidColorBrush x:Key="PlaybarArtBgBrush" Color="#E2E2E2"/>
                    <SolidColorBrush x:Key="PlaybarArtBorderBrush" Color="#1F000000"/>
                    <SolidColorBrush x:Key="PlaybarBadgeBgBrush" Color="#1FD97706"/>
                    <SolidColorBrush x:Key="PlaybarBadgeBorderBrush" Color="#55D97706"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FavouriteStarBrush" Color="#FFC83B"/>
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#121212"/>
                    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#991C1C1C"/>
                    <SolidColorBrush x:Key="EvenRowBrush" Color="#07FFFFFF"/>
                    <SolidColorBrush x:Key="PlayingRowBrush" Color="#1CFFC83B"/>
                    <SolidColorBrush x:Key="SplitterHandleBrush" Color="#30FFFFFF"/>
                    <SolidColorBrush x:Key="PlaybarAcrylicBrush" Color="#A6181818"/>
                    <SolidColorBrush x:Key="PlaybarArtBgBrush" Color="#242424"/>
                    <SolidColorBrush x:Key="PlaybarArtBorderBrush" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="PlaybarBadgeBgBrush" Color="#1AFFC83B"/>
                    <SolidColorBrush x:Key="PlaybarBadgeBorderBrush" Color="#40FFC83B"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="FavouriteStarBrush" Color="#FFD700"/>
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#000000"/>
                    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#000000"/>
                    <SolidColorBrush x:Key="EvenRowBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="PlayingRowBrush" Color="#33FFD700"/>
                    <SolidColorBrush x:Key="SplitterHandleBrush" Color="#80FFFFFF"/>
                    <SolidColorBrush x:Key="PlaybarAcrylicBrush" Color="#000000"/>
                    <SolidColorBrush x:Key="PlaybarArtBgBrush" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="PlaybarArtBorderBrush" Color="#80FFFFFF"/>
                    <SolidColorBrush x:Key="PlaybarBadgeBgBrush" Color="#33FFD700"/>
                    <SolidColorBrush x:Key="PlaybarBadgeBorderBrush" Color="#80FFD700"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
